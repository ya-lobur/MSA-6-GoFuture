@startuml C2_HighAvailability_GoFuture
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title GoFuture — C2 Container Diagram (High Availability, Multi-Region)

' === NEW ELEMENT TAGS (RED for new/changed) ===
AddElementTag("new", $bgColor="#ff4444", $fontColor="white", $borderColor="#cc0000")
AddElementTag("new_db", $bgColor="#cc3333", $fontColor="white", $borderColor="#990000")
AddElementTag("new_queue", $bgColor="#dd3333", $fontColor="white", $borderColor="#aa0000")
AddElementTag("new_boundary", $borderColor="#cc0000", $fontColor="#cc0000")
AddRelTag("new", $textColor="#cc0000", $lineColor="#cc0000")

' === ACTORS ===
Person(passenger, "Пассажир", "Заказывает, отслеживает и оплачивает поездки")
Person(driver, "Водитель", "Принимает заказы, управляет поездками\nи получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет корпоративными поездками и счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты водителям")
Person(dev_engineer, "Разработчик", "Разрабатывает и деплоит сервисы")
Person(sre_engineer, "SRE-инженер", "Мониторит и поддерживает систему")

' === CLIENT APPS ===
System_Boundary(clients, "Client Applications") {
    Container(app_passenger, "Passenger App", "iOS/Android/Huawei", "Мобильное приложение пассажира")
    Container(app_driver, "Driver App", "iOS/Android/Huawei", "Мобильное приложение водителя")
    Container(web_portal, "Corporate Web Portal", "React/Vue.js", "Веб-портал корпоративных клиентов")
    Container(admin_panel, "Admin Panel", "React/Vue.js", "Панель администрирования и управления выплатами")
}

' === [NEW] GLOBAL EDGE / SECURITY LAYER ===
System_Boundary(global_edge, "Global Edge / Security Layer") {
    Container(cloudflare_waf, "WAF / DDoS Protection", "Cloudflare", "Защита от DDoS, SQL-инъекций,\nXSS, OWASP Top 10, rate limiting", $tags="new")
    Container(geodns, "GeoDNS", "Cloudflare DNS / Route 53", "Маршрутизация пользователей\nк ближайшему региону по геолокации", $tags="new")
    Container(cdn, "CDN", "Cloudflare CDN", "Кеширование статического контента,\nAnycast-сеть, edge-оптимизация", $tags="new")
    Container(global_lb, "Global Load Balancer", "Cloudflare LB", "Балансировка между регионами,\nhealth checks, автоматический failover", $tags="new")
}

' ============================================================
' === REGION: CIS (Moscow, Yandex Cloud) — FULL DETAIL ===
' ============================================================
System_Boundary(region_cis, "Region: CIS (Moscow, Yandex Cloud)") {

    ' === EDGE LAYER ===
    System_Boundary(edge_layer_cis, "Edge Layer") {
        Container(api_gateway_cis, "API Gateway", "Kong / NGINX Ingress", "Маршрутизация запросов, rate limiting,\nаутентификация, Strangler Fig роутинг")
        Container(service_mesh_cis, "Service Mesh", "Istio", "mTLS шифрование межсервисного трафика,\nretry, circuit breaker", $tags="new")
    }

    ' === DOMAIN SERVICES ===
    System_Boundary(domain_services_cis, "Domain Microservices") {
        Container(booking_svc_cis, "Booking Service", "FastAPI + PostgreSQL", "Жизненный цикл поездки, координация Saga,\nстатус бронирования, Outbox-таблица")
        Container(driver_svc_cis, "Driver Service", "FastAPI + PostgreSQL + Redis", "Профили водителей, доступность,\nGPS-отслеживание, Outbox-таблица")
        Container(pricing_svc_cis, "Pricing Service", "FastAPI + PostgreSQL + Redis", "Динамическое ценообразование,\nсурж-коэффициенты, расчёт стоимости")
        Container(payments_svc_cis, "Payments Service", "FastAPI + PostgreSQL", "Обработка платежей, авторизация\nсредств, выплаты водителям, Outbox-таблица")
        Container(notification_svc_cis, "Notification Service", "FastAPI + PostgreSQL + Redis", "Push-уведомления для всех платформ,\nevent-driven потребитель")
        Container(geography_svc_cis, "Geography Service", "FastAPI + Elasticsearch + Redis", "Геопоиск водителей, маршрутизация,\nуправление зонами, Outbox-таблица")
        Container(analytics_svc_cis, "Analytics Service", "FastAPI + ClickHouse + Kafka", "Real-time аналитика, агрегация событий,\nбизнес-отчёты, ML-пайплайны")
        Container(fraud_svc_cis, "Fraud Service", "FastAPI + PostgreSQL", "ML-скоринг риска, фрод-детекция,\nOutbox-таблица")
    }

    ' === LEGACY MONOLITH (transitional) ===
    System_Boundary(legacy_layer_cis, "Legacy (Transitional)") {
        Container(monolith_cis, "GoFuture Monolith", "Django Application", "Остаточная бизнес-логика\n(постепенно выводится из эксплуатации)")
        Container(acl_cis, "Anti-Corruption Layer", "FastAPI Adapter", "Адаптер между новыми сервисами\nи монолитной БД на период миграции")
    }

    ' === EVENT PLATFORM ===
    System_Boundary(event_platform_cis, "Event Platform") {
        ContainerQueue(kafka_cis, "Event Bus", "Apache Kafka", "Центральный брокер событий,\nрегиональное партиционирование")
        Container(schema_registry_cis, "Schema Registry", "Confluent Schema Registry", "Управление схемами событий\n(Avro/Protobuf), контроль совместимости")
        Container(debezium_cis, "Outbox Relay", "Debezium CDC", "Захват изменений из Outbox-таблиц\nсервисов через PostgreSQL WAL")
        Container(flink_cis, "Stream Processing", "Apache Flink", "Потоковая обработка: сурж-прайсинг,\nфрод-скоринг, аналитика, матчинг")
        ContainerQueue(retry_topics_cis, "Retry / DLQ Topics", "Apache Kafka", "Повторная обработка с экспоненциальной\nзадержкой и Dead Letter Queue")
    }

    ' === DATA STORES ===
    System_Boundary(data_stores_cis, "Shared Data Infrastructure") {
        ContainerDb(redis_cache_cis, "Distributed Cache", "Redis Cluster", "Кеширование данных, сессии,\nrate limiting, локации водителей")
        ContainerDb(elasticsearch_cis, "Search Engine", "Elasticsearch / OpenSearch", "Геопоиск водителей,\nполнотекстовый поиск")
        ContainerDb(clickhouse_cis, "Analytics DB", "ClickHouse", "Хранение аналитических данных,\nметрик бизнеса, ML-фичи")
        ContainerDb(pg_primary_cis, "PostgreSQL Primary", "Patroni + PostgreSQL", "Мастер-узел БД региона CIS,\nавтоматический failover через Patroni", $tags="new_db")
    }

    ' === [NEW] NETWORK SECURITY ===
    Container(network_policy_cis, "Network Policies", "Calico", "Сетевые политики: east-west\nфильтрация трафика в K8s кластере", $tags="new")
}

' ============================================================
' === REGION: SEA (Singapore, AWS) — COLLAPSED ===
' ============================================================
System_Boundary(region_sea, "Region: SEA (Singapore, AWS ap-southeast-1)") {
