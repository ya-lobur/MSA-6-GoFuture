    Container(services_sea, "Domain Microservices", "FastAPI (8 сервисов)", "Полный набор микросервисов:\nBooking, Driver, Pricing, Payments,\nNotification, Geography, Analytics, Fraud", $tags="new")
    ContainerQueue(kafka_sea, "Event Bus", "Apache Kafka", "Региональный Kafka-кластер\nс локальным партиционированием", $tags="new_queue")
    ContainerDb(pg_primary_sea, "PostgreSQL Primary", "Patroni + PostgreSQL", "Мастер-узел БД региона SEA", $tags="new_db")
    ContainerDb(redis_sea, "Redis Cache", "Redis Cluster", "Региональный кеш", $tags="new_db")
