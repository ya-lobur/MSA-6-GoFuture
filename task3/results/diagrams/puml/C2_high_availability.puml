}

' ============================================================
' === [NEW] CROSS-REGION INFRASTRUCTURE ===
' ============================================================
System_Boundary(cross_region, "Cross-Region Infrastructure") {
    Container(mirrormaker, "MirrorMaker 2", "Kafka MirrorMaker 2", "Репликация выбранных топиков\nмежду регионами (аналитика,\nфрод-правила, конфигурация)", $tags="new")
    Container(pg_replication, "DB Replication Manager", "Logical Replication", "Кросс-региональная репликация\nглобальных данных (профили, правила)", $tags="new")
    Container(thanos, "Thanos", "Thanos / Mimir", "Глобальная агрегация метрик\nиз всех региональных Prometheus", $tags="new")
}

' === OBSERVABILITY (per-region, shown once) ===
System_Boundary(observability, "Observability Platform (per region)") {
    Container(otel_collector, "OpenTelemetry Collector", "OTel Collector", "Централизованный сбор телеметрии:\nметрики, трейсы, логи от всех сервисов")
    Container(prometheus, "Prometheus", "Monitoring", "Сбор и хранение метрик сервисов,\nKafka, Flink, Outbox")
    Container(grafana, "Grafana", "Visualization", "Дашборды: Kafka Overview, Consumer Lag,\nSaga Health, Event Flow, Flink Jobs,\nMulti-Region Overview")
    Container(loki, "Loki", "Log Aggregation", "Централизованный сбор логов")
    Container(tempo, "Tempo", "Distributed Tracing", "Распределённая трассировка запросов\nи событий через correlation_id")
    Container(alertmanager, "Alertmanager", "Alert System", "Алерты: consumer lag, DLQ,\nunder-replicated partitions, saga failures,\nregion health, failover events")
    Container(kafka_exporter, "Kafka Exporter", "Prometheus Exporter", "Экспорт метрик Kafka-брокеров\nи топиков в Prometheus")
    Container(burrow, "Burrow", "Consumer Lag Monitor", "Мониторинг consumer lag,\nоценка статуса consumer groups")
}

' === CI/CD ===
System_Boundary(cicd, "CI/CD Platform") {
    Container(github_actions, "GitHub Actions", "CI/CD", "Сборка, тестирование,\nвалидация схем, публикация образов")
    Container(argocd, "Argo CD", "GitOps", "Непрерывная доставка в Kubernetes\n(multi-cluster деплой)")
    Container(helm, "Helm Charts", "Package Manager", "Шаблонизация деплоя сервисов")
    Container(docker_registry, "Container Registry", "Docker Registry", "Хранение Docker-образов")
}

