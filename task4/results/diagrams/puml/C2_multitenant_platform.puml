' ============================================================

' === Users → Client Apps ===
Rel(passenger, app_passenger, "Использует")
Rel(driver, app_driver, "Использует")
Rel(manager, web_portal, "Использует")
Rel(accountant, admin_panel, "Использует")
Rel(dev_engineer, github_actions, "Запускает пайплайны")
Rel(sre_engineer, grafana, "Мониторит систему")
Rel(partner_admin, partner_portal, "Управляет тенантом", $tags="new")
Rel(partner_developer, api_gateway_cis, "Partner API (OAuth 2.0\nClient Credentials)", $tags="new")

' === Client Apps → Global Edge Layer ===
Rel(app_passenger, cloudflare_waf, "HTTPS-запросы", "HTTPS")
Rel(app_driver, cloudflare_waf, "HTTPS-запросы", "HTTPS")
Rel(web_portal, cloudflare_waf, "HTTPS-запросы", "HTTPS")
Rel(admin_panel, cloudflare_waf, "HTTPS-запросы", "HTTPS")
Rel(partner_portal, cloudflare_waf, "HTTPS-запросы", "HTTPS", $tags="new")

' === Global Edge routing ===
Rel(cloudflare_waf, cdn, "Статический контент", "Cache")
Rel(cloudflare_waf, geodns, "API-запросы", "DNS Resolution")
Rel(geodns, global_lb, "Определение ближайшего региона", "Latency-based routing")

' === Global LB → Regional API Gateways ===
Rel(global_lb, api_gateway_cis, "Трафик CIS", "HTTPS")
Rel(global_lb, api_gateway_sea, "Трафик SEA", "HTTPS")
Rel(global_lb, api_gateway_latam, "Трафик LATAM", "HTTPS")

' === [NEW] API Gateway → Keycloak (JWT validation) ===
Rel(api_gateway_cis, keycloak_cis, "JWT-валидация,\nOIDC Discovery", "OIDC/OAuth 2.0", $tags="new")

' === [NEW] API Gateway → Multi-Tenant Platform ===
Rel(api_gateway_cis, tenant_mgmt_svc_cis, "Управление тенантами", "REST", $tags="new")
Rel(api_gateway_cis, onboarding_svc_cis, "Регистрация партнёра", "REST", $tags="new")

' === CIS Region: API Gateway → Domain Services ===
Rel(api_gateway_cis, booking_svc_cis, "Маршрутизация запросов\n+ X-Tenant-ID", "REST")
Rel(api_gateway_cis, driver_svc_cis, "Маршрутизация запросов", "REST")
Rel(api_gateway_cis, pricing_svc_cis, "Маршрутизация запросов", "REST")
Rel(api_gateway_cis, payments_svc_cis, "Маршрутизация запросов", "REST")
Rel(api_gateway_cis, geography_svc_cis, "Маршрутизация запросов", "REST")
Rel(api_gateway_cis, analytics_svc_cis, "Маршрутизация запросов", "REST")
Rel(api_gateway_cis, monolith_cis, "Немигрированные эндпоинты", "REST")

' === CIS: Synchronous inter-service calls ===
Rel(booking_svc_cis, pricing_svc_cis, "Расчёт стоимости", "REST")
Rel(booking_svc_cis, geography_svc_cis, "Построение маршрута", "REST")
Rel(payments_svc_cis, fraud_svc_cis, "Проверка транзакции", "REST")

' === CIS: Services → Outbox → Debezium (CDC) ===
Rel(booking_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")
Rel(driver_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")
Rel(payments_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")
Rel(fraud_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")
Rel(geography_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")
Rel(pricing_svc_cis, debezium_cis, "Outbox-таблица → CDC", "PostgreSQL WAL")

' === CIS: Debezium → Kafka ===
Rel(debezium_cis, kafka_cis, "Публикация доменных событий", "Kafka Producer")

' === CIS: Kafka → Schema Registry ===
Rel(kafka_cis, schema_registry_cis, "Валидация схем событий", "HTTP")

' === CIS: Kafka → Consuming services (Choreography Saga) ===
Rel(kafka_cis, booking_svc_cis, "Saga-события: DriverAssigned,\nPaymentAuthorized, FraudCheckPassed", "Kafka Consumer")
Rel(kafka_cis, driver_svc_cis, "BookingCreated →\nназначение водителя", "Kafka Consumer")
Rel(kafka_cis, pricing_svc_cis, "BookingCreated →\nрасчёт стоимости", "Kafka Consumer")
Rel(kafka_cis, payments_svc_cis, "BookingConfirmed →\nавторизация платежа", "Kafka Consumer")
Rel(kafka_cis, notification_svc_cis, "Все доменные события →\nуведомления пользователей", "Kafka Consumer")
Rel(kafka_cis, analytics_svc_cis, "Все доменные события →\nreal-time аналитика", "Kafka Consumer")
Rel(kafka_cis, fraud_svc_cis, "BookingCreated, PaymentInitiated →\nML-скоринг риска", "Kafka Consumer")

' === [NEW] Kafka → Provisioning Workers (Tenant Lifecycle) ===
Rel(kafka_cis, keycloak_provisioner_cis, "TenantApproved →\nпровижининг реалма", "Kafka Consumer", $tags="new")
Rel(kafka_cis, db_provisioner_cis, "TenantApproved →\nсоздание схемы БД", "Kafka Consumer", $tags="new")
Rel(kafka_cis, monitoring_provisioner_cis, "TenantApproved →\nнастройка мониторинга", "Kafka Consumer", $tags="new")
Rel(kafka_cis, audit_svc_cis, "Аудит-события →\nзапись в хранилище", "Kafka Consumer", $tags="new")

' === [NEW] Tenant Management → Kafka (lifecycle events) ===
Rel(tenant_mgmt_svc_cis, kafka_cis, "TenantApproved, TenantDeactivated,\nаудит-события", "Kafka Producer", $tags="new")

' === [NEW] Provisioning Workers → Kafka (completion events) ===
Rel(keycloak_provisioner_cis, kafka_cis, "KeycloakProvisioningCompleted/Failed", "Kafka Producer", $tags="new")
Rel(db_provisioner_cis, kafka_cis, "DatabaseProvisioningCompleted/Failed", "Kafka Producer", $tags="new")
Rel(monitoring_provisioner_cis, kafka_cis, "MonitoringProvisioningCompleted/Failed", "Kafka Producer", $tags="new")

' === [NEW] Kafka → Tenant Mgmt (aggregation of provisioning statuses) ===
Rel(kafka_cis, tenant_mgmt_svc_cis, "Агрегация статусов\nпровижининга → ACTIVE", "Kafka Consumer", $tags="new")

