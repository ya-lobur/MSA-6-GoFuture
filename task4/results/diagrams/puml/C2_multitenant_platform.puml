@startuml C2_Multitenant_GoFuture
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title GoFuture — C2 Container Diagram (Multi-Tenant Platform)

' === NEW ELEMENT TAGS (RED for new/changed) ===
AddElementTag("new", $bgColor="#ff4444", $fontColor="white", $borderColor="#cc0000")
AddElementTag("new_db", $bgColor="#cc3333", $fontColor="white", $borderColor="#990000")
AddElementTag("new_queue", $bgColor="#dd3333", $fontColor="white", $borderColor="#aa0000")
AddElementTag("new_boundary", $borderColor="#cc0000", $fontColor="#cc0000")
AddRelTag("new", $textColor="#cc0000", $lineColor="#cc0000")

' === ACTORS ===
Person(passenger, "Пассажир", "Заказывает, отслеживает и оплачивает поездки")
Person(driver, "Водитель", "Принимает заказы, управляет поездками\nи получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет корпоративными поездками и счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты водителям")
Person(dev_engineer, "Разработчик", "Разрабатывает и деплоит сервисы")
Person(sre_engineer, "SRE-инженер", "Мониторит и поддерживает систему")
Person(partner_admin, "Администратор партнёра", "Управляет своим тенантом,\nпользователями и конфигурацией", $tags="new")
Person(partner_developer, "Разработчик партнёра", "Интегрируется с GoFuture\nчерез Partner API", $tags="new")

' === CLIENT APPS ===
System_Boundary(clients, "Client Applications") {
    Container(app_passenger, "Passenger App", "iOS/Android/Huawei", "Мобильное приложение пассажира")
    Container(app_driver, "Driver App", "iOS/Android/Huawei", "Мобильное приложение водителя")
    Container(web_portal, "Corporate Web Portal", "React/Vue.js", "Веб-портал корпоративных клиентов")
    Container(admin_panel, "Admin Panel", "React/Vue.js", "Панель администрирования и управления выплатами")
    Container(partner_portal, "Partner Portal", "React/Vue.js", "Портал партнёра: регистрация,\nуправление тенантом, дашборды", $tags="new")
}

' === GLOBAL EDGE / SECURITY LAYER ===
System_Boundary(global_edge, "Global Edge / Security Layer") {
    Container(cloudflare_waf, "WAF / DDoS Protection", "Cloudflare", "Защита от DDoS, SQL-инъекций,\nXSS, OWASP Top 10, rate limiting")
    Container(geodns, "GeoDNS", "Cloudflare DNS / Route 53", "Маршрутизация пользователей\nк ближайшему региону по геолокации")
    Container(cdn, "CDN", "Cloudflare CDN", "Кеширование статического контента,\nAnycast-сеть, edge-оптимизация")
    Container(global_lb, "Global Load Balancer", "Cloudflare LB", "Балансировка между регионами,\nhealth checks, автоматический failover")
}

' ============================================================
' === REGION: CIS (Moscow, Yandex Cloud) — FULL DETAIL ===
' ============================================================
System_Boundary(region_cis, "Region: CIS (Moscow, Yandex Cloud)") {

    ' === EDGE LAYER ===
    System_Boundary(edge_layer_cis, "Edge Layer") {
        Container(api_gateway_cis, "API Gateway", "Kong / NGINX Ingress", "Маршрутизация запросов, rate limiting,\nJWT-валидация через Keycloak,\nX-Tenant-ID injection")
        Container(service_mesh_cis, "Service Mesh", "Istio", "mTLS шифрование межсервисного трафика,\nretry, circuit breaker")
    }

    ' === [NEW] MULTI-TENANT PLATFORM ===
    System_Boundary(multitenant_platform_cis, "Multi-Tenant Platform") {
        Container(keycloak_cis, "Keycloak IAM", "Keycloak", "Identity Provider: OIDC/OAuth 2.0,\nRealm-per-tenant, SSO, RBAC,\nфедерация с внешними IdP", $tags="new")
        Container(tenant_mgmt_svc_cis, "Tenant Management Service", "FastAPI + PostgreSQL", "Жизненный цикл тенантов: создание,\nактивация, деактивация, квоты,\nагрегация статусов провижининга", $tags="new")
        Container(onboarding_svc_cis, "Partner Onboarding Service", "FastAPI", "Регистрация партнёров, валидация,\nworkflow одобрения заявок", $tags="new")
    }

    ' === [NEW] PROVISIONING WORKERS ===
    System_Boundary(provisioning_workers_cis, "Provisioning Workers") {
        Container(keycloak_provisioner_cis, "Keycloak Provisioner", "FastAPI Worker", "Создание реалма, ролей, клиентов,\nадминистратора партнёра в Keycloak", $tags="new")
        Container(db_provisioner_cis, "Database Provisioner", "FastAPI Worker", "Создание PostgreSQL-схемы,\nAlembic-миграции, настройка RLS", $tags="new")
        Container(monitoring_provisioner_cis, "Monitoring Provisioner", "FastAPI Worker", "Создание Grafana Organization,\nпровижининг дашбордов,\nrecording rules для тенанта", $tags="new")
    }

    ' === [NEW] AUDIT & COMPLIANCE ===
    System_Boundary(audit_layer_cis, "Audit & Compliance") {
        Container(audit_svc_cis, "Audit Log Service", "FastAPI + Kafka Consumer", "Сбор аудит-событий:\nдействия администраторов,\nизменения конфигурации, CRUD тенантов", $tags="new")
        ContainerDb(audit_db_cis, "Audit Storage", "ClickHouse", "Хранение аудит-логов,\nзапросы для compliance-отчётов", $tags="new_db")
    }

    ' === DOMAIN SERVICES ===
    System_Boundary(domain_services_cis, "Domain Microservices") {
        Container(booking_svc_cis, "Booking Service", "FastAPI + PostgreSQL", "Жизненный цикл поездки, координация Saga,\nстатус бронирования, Outbox-таблица\n+ tenant_id в каждом запросе")
        Container(driver_svc_cis, "Driver Service", "FastAPI + PostgreSQL + Redis", "Профили водителей, доступность,\nGPS-отслеживание, Outbox-таблица")
        Container(pricing_svc_cis, "Pricing Service", "FastAPI + PostgreSQL + Redis", "Динамическое ценообразование,\nсурж-коэффициенты, расчёт стоимости")
        Container(payments_svc_cis, "Payments Service", "FastAPI + PostgreSQL", "Обработка платежей, авторизация\nсредств, выплаты водителям, Outbox-таблица")
        Container(notification_svc_cis, "Notification Service", "FastAPI + PostgreSQL + Redis", "Push-уведомления для всех платформ,\nevent-driven потребитель")
        Container(geography_svc_cis, "Geography Service", "FastAPI + Elasticsearch + Redis", "Геопоиск водителей, маршрутизация,\nуправление зонами, Outbox-таблица")
        Container(analytics_svc_cis, "Analytics Service", "FastAPI + ClickHouse + Kafka", "Real-time аналитика, агрегация событий,\nбизнес-отчёты, ML-пайплайны")
        Container(fraud_svc_cis, "Fraud Service", "FastAPI + PostgreSQL", "ML-скоринг риска, фрод-детекция,\nOutbox-таблица")
    }

    ' === LEGACY MONOLITH (transitional) ===
    System_Boundary(legacy_layer_cis, "Legacy (Transitional)") {
        Container(monolith_cis, "GoFuture Monolith", "Django Application", "Остаточная бизнес-логика\n(постепенно выводится из эксплуатации)")
        Container(acl_cis, "Anti-Corruption Layer", "FastAPI Adapter", "Адаптер между новыми сервисами\nи монолитной БД на период миграции")
    }

    ' === EVENT PLATFORM ===
    System_Boundary(event_platform_cis, "Event Platform") {
        ContainerQueue(kafka_cis, "Event Bus", "Apache Kafka", "Центральный брокер событий,\nрегиональное партиционирование,\ntenant_id в ключах/заголовках")
        Container(schema_registry_cis, "Schema Registry", "Confluent Schema Registry", "Управление схемами событий\n(Avro/Protobuf), контроль совместимости")
        Container(debezium_cis, "Outbox Relay", "Debezium CDC", "Захват изменений из Outbox-таблиц\nсервисов через PostgreSQL WAL")
        Container(flink_cis, "Stream Processing", "Apache Flink", "Потоковая обработка: сурж-прайсинг,\nфрод-скоринг, аналитика, матчинг")
        ContainerQueue(retry_topics_cis, "Retry / DLQ Topics", "Apache Kafka", "Повторная обработка с экспоненциальной\nзадержкой и Dead Letter Queue")
    }

    ' === DATA STORES ===
    System_Boundary(data_stores_cis, "Shared Data Infrastructure") {
        ContainerDb(redis_cache_cis, "Distributed Cache", "Redis Cluster", "Кеширование данных, сессии,\nrate limiting, локации водителей\nkey prefix: {tenant_id}:")
        ContainerDb(elasticsearch_cis, "Search Engine", "Elasticsearch / OpenSearch", "Геопоиск водителей,\nindex-per-tenant: {tenant_id}-{index}")
        ContainerDb(clickhouse_cis, "Analytics DB", "ClickHouse", "Хранение аналитических данных,\nметрик бизнеса, tenant_id column")
        ContainerDb(pg_primary_cis, "PostgreSQL Primary", "Patroni + PostgreSQL", "Мастер-узел БД региона CIS,\nschema-per-tenant изоляция,\nавтоматический failover через Patroni")
        ContainerDb(tenant_metadata_db_cis, "Tenant Metadata DB", "PostgreSQL", "Метаданные тенантов: конфигурация,\nквоты, статусы, контактные данные", $tags="new_db")
    }

    ' === NETWORK SECURITY ===
    Container(network_policy_cis, "Network Policies", "Calico", "Сетевые политики: east-west\nфильтрация трафика в K8s кластере")
}

' ============================================================
' === REGION: SEA (Singapore, AWS) — COLLAPSED ===
' ============================================================
System_Boundary(region_sea, "Region: SEA (Singapore, AWS ap-southeast-1)") {
    Container(api_gateway_sea, "API Gateway", "Kong / NGINX Ingress", "Региональная маршрутизация запросов")
    Container(keycloak_sea, "Keycloak IAM", "Keycloak", "Региональный экземпляр IAM", $tags="new")
    Container(services_sea, "Domain Microservices", "FastAPI (8 сервисов)", "Полный набор микросервисов:\nBooking, Driver, Pricing, Payments,\nNotification, Geography, Analytics, Fraud")
    Container(tenant_platform_sea, "Tenant Platform Services", "FastAPI", "Tenant Mgmt + Onboarding +\nProvisioning Workers", $tags="new")
    ContainerQueue(kafka_sea, "Event Bus", "Apache Kafka", "Региональный Kafka-кластер\nс tenant_id в ключах/заголовках", $tags="new_queue")
    ContainerDb(pg_primary_sea, "PostgreSQL Primary", "Patroni + PostgreSQL", "Мастер-узел БД региона SEA,\nschema-per-tenant", $tags="new_db")
    ContainerDb(redis_sea, "Redis Cache", "Redis Cluster", "Региональный кеш", $tags="new_db")
    Container(service_mesh_sea, "Service Mesh", "Istio", "mTLS, circuit breaker")
    Container(network_policy_sea, "Network Policies", "Calico", "East-west фильтрация трафика")
}

' ============================================================
' === REGION: LATAM (São Paulo, AWS) — COLLAPSED ===
' ============================================================
System_Boundary(region_latam, "Region: LATAM (São Paulo, AWS sa-east-1)") {
    Container(api_gateway_latam, "API Gateway", "Kong / NGINX Ingress", "Региональная маршрутизация запросов")
    Container(keycloak_latam, "Keycloak IAM", "Keycloak", "Региональный экземпляр IAM", $tags="new")
    Container(services_latam, "Domain Microservices", "FastAPI (8 сервисов)", "Полный набор микросервисов:\nBooking, Driver, Pricing, Payments,\nNotification, Geography, Analytics, Fraud")
    Container(tenant_platform_latam, "Tenant Platform Services", "FastAPI", "Tenant Mgmt + Onboarding +\nProvisioning Workers", $tags="new")
    ContainerQueue(kafka_latam, "Event Bus", "Apache Kafka", "Региональный Kafka-кластер\nс tenant_id в ключах/заголовках", $tags="new_queue")
    ContainerDb(pg_primary_latam, "PostgreSQL Primary", "Patroni + PostgreSQL", "Мастер-узел БД региона LATAM,\nschema-per-tenant", $tags="new_db")
    ContainerDb(redis_latam, "Redis Cache", "Redis Cluster", "Региональный кеш", $tags="new_db")
    Container(service_mesh_latam, "Service Mesh", "Istio", "mTLS, circuit breaker")
    Container(network_policy_latam, "Network Policies", "Calico", "East-west фильтрация трафика")
}

' ============================================================
' === CROSS-REGION INFRASTRUCTURE ===
' ============================================================
System_Boundary(cross_region, "Cross-Region Infrastructure") {
    Container(mirrormaker, "MirrorMaker 2", "Kafka MirrorMaker 2", "Репликация выбранных топиков\nмежду регионами (аналитика,\nфрод-правила, конфигурация,\ntenant lifecycle)")
    Container(pg_replication, "DB Replication Manager", "Logical Replication", "Кросс-региональная репликация\nглобальных данных (профили, правила,\nтенант-метаданные)")
    Container(thanos, "Thanos", "Thanos / Mimir", "Глобальная агрегация метрик\nиз всех региональных Prometheus,\nкросс-тенантная аналитика")
}

' === OBSERVABILITY (per-region, shown once) ===
System_Boundary(observability, "Observability Platform (per region)") {
    Container(otel_collector, "OpenTelemetry Collector", "OTel Collector", "Централизованный сбор телеметрии:\nметрики, трейсы, логи от всех сервисов\n+ tenant_id label injection")
    Container(prometheus, "Prometheus", "Monitoring", "Сбор и хранение метрик сервисов,\nKafka, Flink, Outbox\n+ tenant_id label на каждой метрике")
    Container(grafana, "Grafana", "Visualization", "Дашборды: Kafka Overview, Consumer Lag,\nSaga Health, Event Flow, Flink Jobs,\nMulti-Region, Tenant Overview,\nOrganization-per-tenant")
    Container(loki, "Loki", "Log Aggregation", "Централизованный сбор логов,\nmulti-tenancy mode (X-Scope-OrgID)")
    Container(tempo, "Tempo", "Distributed Tracing", "Распределённая трассировка запросов\nи событий через correlation_id")
    Container(alertmanager, "Alertmanager", "Alert System", "Алерты: consumer lag, DLQ,\nunder-replicated partitions, saga failures,\nregion health, tenant SLA violations")
    Container(kafka_exporter, "Kafka Exporter", "Prometheus Exporter", "Экспорт метрик Kafka-брокеров\nи топиков в Prometheus")
    Container(burrow, "Burrow", "Consumer Lag Monitor", "Мониторинг consumer lag,\nоценка статуса consumer groups")
}

' === CI/CD ===
System_Boundary(cicd, "CI/CD Platform") {
    Container(github_actions, "GitHub Actions", "CI/CD", "Сборка, тестирование,\nвалидация схем, публикация образов")
    Container(argocd, "Argo CD", "GitOps", "Непрерывная доставка в Kubernetes\n(multi-cluster деплой)")
    Container(helm, "Helm Charts", "Package Manager", "Шаблонизация деплоя сервисов")
    Container(docker_registry, "Container Registry", "Docker Registry", "Хранение Docker-образов")
}

' === EXTERNAL SYSTEMS ===
System_Ext(yandex_pay, "Яндекс Пэй", "Платёжный шлюз")
System_Ext(yandex_maps, "Яндекс Карты", "Картографический сервис")
System_Ext(fcm, "Firebase Cloud Messaging", "Push-уведомления Android")
System_Ext(apns, "Apple Push Notification Service", "Push-уведомления iOS")
System_Ext(huawei_push, "Huawei Push Kit", "Push-уведомления Huawei")
System_Ext(bank_api, "Bank API", "Банковские выплаты водителям")
System_Ext(local_payments_sea, "Local Payment Gateways (SEA)", "GrabPay, GoPay, OVO и др.")
System_Ext(local_payments_latam, "Local Payment Gateways (LATAM)", "Mercado Pago, PIX и др.")
System_Ext(local_maps_sea, "Local Map Providers (SEA)", "HERE Maps, Grab Maps")
System_Ext(local_maps_latam, "Local Map Providers (LATAM)", "HERE Maps, Waze")
System_Ext(partner_idp, "External Partner IdP", "Корпоративная система аутентификации\nпартнёра (SAML 2.0 / OIDC)", $tags="new")

